# Copy this file to .env.local and fill in your values.
# For local dev you can use the service_role key (never deploy it publicly).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-or-service-key

# Set to "true" to load from public/graph-snapshot.json instead of Supabase
VITE_OFFLINE=false
