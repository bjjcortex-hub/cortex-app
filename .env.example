# Copie para .env.local e preencha os valores.
# Ambas as chaves estão em: Supabase Dashboard → Settings → API

# Service role key — só para leitura do grafo BJJ (source_nodes, source_edges).
# Nunca use para user_documents ou auth.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-service-role-key

# Anon key — usada para auth anônimo e user_documents com RLS.
# É segura para o frontend; o RLS garante que cada usuário vê só seus dados.
VITE_SUPABASE_ANON_KEY=your-anon-key

# "true" para carregar o grafo de public/graph-snapshot.json ao invés do Supabase
VITE_OFFLINE=false
